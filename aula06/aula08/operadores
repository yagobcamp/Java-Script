! - Negação "Eu quero uma caneta mas NÃO pode ser da cor  vermelha"
! - true --> false
    false --> true
 
&& - Conjunção "Eu quero uma caneta azul E preta"
&& -  true - true --> true
      true - false --> false
      false - true --> false
      false - false --> false

|| - Disjunção  "Eu quero uma caneta azul OU uma caneta preta"

||    true - true --> true
      true - false --> true
      false - true --> true
      false - false --> false


